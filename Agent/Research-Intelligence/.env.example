N8N_HOST=localhost
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
GENERIC_TIMEZONE=UTC
# Only needed if the Telegram workflow's trigger must receive live messages
# (Telegram calls this URL). Point it at a public tunnel (e.g. a cloudflared
# quick tunnel or ngrok) during local dev, or your real public domain in
# production. Leave as the default if you're not using the Telegram trigger.
WEBHOOK_URL=http://localhost:5678/