# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. .env is gitignored and must
# never be committed -- every value below is a real credential once filled in.
# ---------------------------------------------------------------------------

# --- n8n instance -----------------------------------------------------------
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
GENERIC_TIMEZONE=UTC

# Telegram delivers messages to this URL, so it must be publicly reachable
# from the internet. Point it at a public tunnel (e.g. a cloudflared quick
# tunnel or ngrok) during local development, or your real public domain in
# production. Must end with a trailing slash.
WEBHOOK_URL=http://localhost:5678/

# The owner account the bootstrap script creates on first boot, and which you
# then use to log in at http://localhost:5678.
# Password needs 8+ characters, at least one uppercase letter and one number.
N8N_OWNER_EMAIL=replace-with-your-email@example.com
N8N_OWNER_PASSWORD=replace-with-a-strong-password
N8N_OWNER_FIRST_NAME=Research
N8N_OWNER_LAST_NAME=Intelligence

# --- Telegram bot -----------------------------------------------------------
# Talk to @BotFather on Telegram, run /newbot, and paste the token here.
# Looks like 123456789:AAH-your-long-token-string.
# The bootstrap script turns this into an n8n credential automatically and
# wires it into every Telegram node in both workflows.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# --- arXiv ingestion --------------------------------------------------------
# Comma-separated list of arXiv categories to monitor daily.
# Common ones: cs.AI, cs.LG, cs.CL, cs.CV, stat.ML, cs.NE, cs.RO
# Full list: https://arxiv.org/category_taxonomy
ARXIV_CATEGORIES=cs.AI

# Maximum papers to fetch per category per daily run. Free arXiv API is
# generous but PDF downloads + embedding is I/O and CPU bound, so keep this
# modest unless you have a beefy machine.
ARXIV_MAX_RESULTS=5

# Cron expression for daily ingestion. Default is 08:00 every day.
INGESTION_CRON=0 8 * * *

# --- Models -----------------------------------------------------------------
# Ollama models used for embeddings and generation. Change only if you know
# the model exists in Ollama's library -- the ollama-init container will pull
# whatever is set here on first boot.
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=llama3.2

# --- Dashboard --------------------------------------------------------------
# Host port for the dashboard UI (http://localhost:8080 by default).
DASHBOARD_PORT=8080