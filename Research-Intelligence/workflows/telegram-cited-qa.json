        "url": "={{ ($env.OLLAMA_BASE_URL || 'http://ollama:11434') + '/api/chat' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.empty ? { model: ($env.GENERATION_MODEL || 'llama3.2'), stream: false, keep_alive: '30m', messages: [{ role: 'assistant', content: 'The research index does not yet cover this question. Try again once daily ingestion has run, or ask about the paper categories I already track.' }] } : { model: ($env.GENERATION_MODEL || 'llama3.2'), stream: false, keep_alive: '30m', messages: [{ role: 'system', content: 'You are a precise research assistant. Never invent sources or citations.' }, { role: 'user', content: $json.prompt }] } }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "generate-answer",
      "name": "Generate cited answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        208
      ],
      "retryOnFail": true,
      "maxTries": 3,
