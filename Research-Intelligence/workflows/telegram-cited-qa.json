    {
      "parameters": {
        "jsCode": "const question = $('Normalise question').item.json;\nconst documents = $json.documents?.[0] ?? [];\nconst metadata = $json.metadatas?.[0] ?? [];\nif (documents.length === 0) {\n  return [{ json: { ...question, prompt: null, empty: true, sourceCount: 0 } }];\n}\n// Label context entries as (Source n), not [n]: about a third of chunks are\n// body text carrying the paper's own [11]-style reference markers, and a [n]\n// instruction collides with those badly enough that the model starts citing\n// numbers that do not exist in the context.\nconst context = documents\n  .map((text, index) => `(Source ${index + 1}) ${metadata[index]?.title ?? 'Unknown paper'} [${metadata[index]?.arxivId ?? 'n/a'}]\\n${text}`)\n  .join('\\n\\n');\nconst valid = documents.map((_, i) => `(Source ${i + 1})`).join(', ');\nconst prompt = `Answer only from the supplied research context. State when the context is insufficient.\\n\\nCite every factual claim using ONLY these exact labels: ${valid}. Do not invent any other source label. The research text below contains the papers' own bracketed reference numbers such as [11] or [18] -- those are part of the quoted text and must never be used as citations.\\n\\nEnd with a Sources section listing each label you cited with its paper title and arXiv ID.\\n\\nQuestion: ${question.question}\\n\\nResearch context:\\n${context}`;\nreturn [{ json: { ...question, prompt, empty: false, sourceCount: documents.length } }];"
      },
      "id": "build-grounded-prompt",
      "name": "Build grounded prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
