    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Deterministic backstop: the model is told twice (system message + user\n// prompt) never to invent a source label, and still sometimes does --\n// confirmed live, citing a 'Source 36' backed by a fabricated Nature paper\n// that was never retrieved. Two tiers: surgically strip the specific\n// patterns that carry fabricated content (a parenthesised citation, a\n// bibliography line), then a looser sweep for any other 'Source N' mention\n// in free text (e.g. \"Sources 1 and 36\") that the first pass can't safely\n// rewrite without risking broken grammar -- surfaced as a warning instead.\nconst raw = $json;\nconst promptCtx = $('Build grounded prompt').item.json;\nconst numSources = promptCtx.sourceCount || 0;\nlet answer = raw.message?.content || '';\n// Generation is allowed to fail without ending the run. Say so, rather\n// than leaving the person waiting on a reply that will never arrive.\nconst generationFailed = !answer.trim();\nif (generationFailed) {\n  answer = 'I could not produce an answer just now - the local model did not respond in time. '\n    + 'Please ask again in a minute.';\n}\nconst invalid = [];\n\nif (numSources > 0) {\n  // Tier 1a: parenthesised inline citations -- safe to replace in place.\n  answer = answer.replace(/\\(Source (\\d+)\\)/g, (match, n) => {\n    const num = Number(n);\n    if (num >= 1 && num <= numSources) return match;\n    invalid.push(num);\n    return '(uncited claim)';\n  });\n\n  // Tier 1b: fabricated bibliography lines -- drop the whole line, since\n  // everything after the colon is invented (title, journal, DOI, ...).\n  const lines = answer.split('\\n').filter((line) => {\n    const m = line.match(/^\\s*[-*]?\\s*Source (\\d+)\\s*:/i);\n    if (!m) return true;\n    const num = Number(m[1]);\n    if (num >= 1 && num <= numSources) return true;\n    invalid.push(num);\n    return false;\n  });\n  answer = lines.join('\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\n\n  // Tier 2: a looser sweep for numbers grammatically tied to the word\n  // 'Source'/'Sources' elsewhere in the prose (e.g. \"Sources 1 and 36\"),\n  // not just the parenthesised form Tier 1 rewrites. Anchored to numbers\n  // immediately following the word (joined only by 'and'/','/'&') so an\n  // unrelated number later in the same sentence -- a page, a year -- can't\n  // be swept in. Flagged rather than edited in place, since surgically\n  // rewriting arbitrary prose risks producing broken grammar.\n  const looseMatches = answer.matchAll(/\\bSources?\\s+(\\d+(?:\\s*(?:,|and|&)\\s*\\d+)*)/gi);\n  for (const m of looseMatches) {\n    const nums = m[1].match(/\\d+/g) || [];\n    for (const n of nums) {\n      const num = Number(n);\n      if (num < 1 || num > numSources) invalid.push(num);\n    }\n  }\n\n  if (invalid.length > 0) {\n    const uniq = [...new Set(invalid)];\n    answer += `\\n\\n\\u26a0\\ufe0f This answer referenced source number${uniq.length > 1 ? 's' : ''} ${uniq.join(', ')}, which ${uniq.length > 1 ? 'are' : 'is'} outside the ${numSources} passages actually retrieved -- likely hallucinated. Treat any claim tied to ${uniq.length > 1 ? 'those numbers' : 'that number'} with caution.`;\n  }\n}\n\n\n// Telegram parses the message body as Markdown by default and rejects the\n// whole request if an entity is left open. Model output routinely contains an\n// odd number of asterisks or an unmatched bracket, which is what produced\n// \"can't parse entities\" on a live question. Escaping for HTML mode makes\n// every character literal, so no generated answer can break the send.\n// Telegram caps a message at 4096 characters. Clip the raw text first and\n// escape afterwards: clipping escaped text can cut an entity such as &amp;\n// in half, which Telegram rejects just like unbalanced Markdown.\nconst LIMIT = 3600;\nconst clipped = (answer.length > LIMIT\n  ? answer.slice(0, LIMIT) + '\\n\\n[answer truncated - ask a narrower question for the full reply]'\n  : answer)\n  .replace(/[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?<![\\uD800-\\uDBFF])[\\uDC00-\\uDFFF]/g, '');\nconst safeForTelegram = clipped\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nreturn { json: { ...raw, safeAnswer: safeForTelegram, rawAnswer: answer, invalidCitationCount: invalid.length } };"
      },
